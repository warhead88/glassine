{
  "$comment": "Glassine 0.4 design tokens. Single source for the scenes (scenes/build.py), the app's asset catalog and the site. Roles are described in TOKENS.md.",
  "light": {
    "desk": "#D4D7CE",
    "paper": "#EFEFEA",
    "card": "#F9F9F6",
    "key": "#F2F2EC",
    "ink": "#1C2230",
    "ink2": "#585F6C",
    "ink3": "#666C77",
    "rule": "#E3E3DC",
    "border": "#D5D6CE",
    "track": "#DADAD2",
    "rec": "#D43D2A",
    "sage": "#869B80",
    "sage_deep": "#4E6849",
    "sage_tint": "#DDE5D8",
    "blue": "#5E7C9E",
    "blue_deep": "#3B5878",
    "peach": "#EAC9A6",
    "ochre": "#93671F",
    "shadow": "#1C2230",
    "on_ink": "#F7F6F1",
    "screen": "#DCDCD4",
    "notch": "#16181D"
  },
  "dark": {
    "desk": "#0C0E12",
    "paper": "#181B21",
    "card": "#20242B",
    "key": "#282C34",
    "ink": "#ECEBE4",
    "ink2": "#A4A7AE",
    "ink3": "#8A8E97",
    "rule": "#2B3038",
    "border": "#30353E",
    "track": "#3A3F48",
    "rec": "#E4583F",
    "sage": "#A3B59C",
    "sage_deep": "#A9BCA2",
    "sage_tint": "#2C3530",
    "blue": "#8EA6C2",
    "blue_deep": "#9DB3CC",
    "peach": "#E0C2A2",
    "ochre": "#D2A65E",
    "shadow": "#000000",
    "on_ink": "#181B21",
    "screen": "#2A2E35",
    "notch": "#000000"
  },
  "accents": {
    "$comment": "fill = buttons, toggles, selection; on = text/icons on fill. Rec is not an accent. system = NSColor.controlAccentColor, on-colour chosen by luminance.",
    "ink":    { "light": { "fill": "#1C2230", "on": "#F7F6F1" }, "dark": { "fill": "#ECEBE4", "on": "#181B21" } },
    "sage":   { "light": { "fill": "#4E6849", "on": "#FFFFFF" }, "dark": { "fill": "#A3B59C", "on": "#181B21" } },
    "stamp":  { "light": { "fill": "#3B5878", "on": "#FFFFFF" }, "dark": { "fill": "#8EA6C2", "on": "#181B21" } },
    "ochre":  { "light": { "fill": "#93671F", "on": "#FFFFFF" }, "dark": { "fill": "#D2A65E", "on": "#181B21" } },
    "system": null
  },
  "type": {
    "serif": "Fraunces (SOFT 100, WONK 0, opsz auto). No tnum: set timer digits in fixed-width cells",
    "sans": "SF Pro (system)",
    "mono": "SF Mono",
    "scale": {
      "display": { "family": "serif", "size": 46, "weight": 440, "tracking": -0.6 },
      "title":   { "family": "serif", "size": 28, "weight": 460, "tracking": -0.3 },
      "timer":   { "family": "serif", "size": 23, "weight": 460 },
      "chip":    { "family": "serif", "size": 14.5, "weight": 500 },
      "date":    { "family": "serif", "size": 14, "weight": 440, "italic": true },
      "body":    { "family": "sans", "size": 14 },
      "note":    { "family": "sans", "size": 13 },
      "label":   { "family": "mono", "size": 9.5, "weight": 500, "tracking": 1.1, "uppercase": true }
    }
  },
  "radius": { "window": 14, "card": 12, "control": 8, "key": 5, "pill": "height / 2" },
  "perforation": { "hole": 2.5, "pitch": 8.4 }
}
