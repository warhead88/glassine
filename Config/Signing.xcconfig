// How Glassine is code-signed.
//
// Without settings of your own it is signed ad hoc: it builds and runs, but macOS forgets the
// Screen Recording permission after every rebuild, because the permission belongs to the
// signature. For a signature that stays the same, copy Signing.local.xcconfig.example to
// Signing.local.xcconfig (not committed) and set your Apple ID's team — a free Personal Team
// works — or the name of a self-signed certificate.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
